env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Large Datasets & Raw Captures (Crucial: never commit raw dataset files)
data/raw/
data/processed/
data/interim/
data/cache/
*.csv
*.pcap
*.pcapng
*.parquet
*.feather
*.h5
*.hdf5
*.zip
